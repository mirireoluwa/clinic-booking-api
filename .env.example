# Postgres connection string (Neon, Supabase, or a local database)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The key every API request must send in the X-API-Key header
API_KEY=change-me

# Optional. A second key the web page uses. It can list slots, book and read a
# booking, but it cannot reset data or cancel. It is public by design, so make it
# different from API_KEY. If you leave it out, the page asks for a key instead.
WEB_KEY=change-me-too

# Optional. Defaults shown.
PORT=3000
SEED_DEMO_SLOTS=true
